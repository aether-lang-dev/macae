// mac.keychain — a secret in the user's login keychain, as a generic
// password keyed by (service, account): API tokens, passwords, anything an
// app must keep but must not write to a file.
//
//   err = keychain.set("org.example.app", "api-token", "s3cr3t")
//   tok, err = keychain.get("org.example.app", "api-token")
//   err = keychain.delete("org.example.app", "api-token")
//
// The app that stored an item reads it back silently; a different app is
// asked by the user. available() is 0 when the process has no usable
// keychain (some CI and ssh sessions, where writes fail with "user
// interaction is not allowed"); it probes by writing and deleting an item.
@source("keychain.c")
@link("-Wl,-framework,Security")
@link("-Wl,-framework,CoreFoundation")

exports(set, get, delete, available, status_text, NOT_FOUND)

import std.string

extern macae_keychain_set(service: string, account: string, secret: string) -> int
extern macae_keychain_get(service: string, account: string) -> string @heap
extern macae_keychain_last_status() -> int
extern macae_keychain_delete(service: string, account: string) -> int
extern macae_keychain_available() -> int
extern macae_keychain_status_text(st: int) -> string @heap

// errSecItemNotFound
const NOT_FOUND: int = -25300

available() -> int { return macae_keychain_available() }

// The Security framework's own words for a status code.
status_text(st: int) -> string { return macae_keychain_status_text(st) }

// Store (replacing any existing) — "" or an error.
set(service: string, account: string, secret: string) -> string {
    st = macae_keychain_set(service, account, secret)
    if st == 0 { return "" }
    return "keychain: ${status_text(st)} (${st})"
}

// (secret, "") or ("", error) — a missing item is the error "not found".
get(service: string, account: string) -> {
    v = macae_keychain_get(service, account)
    st = macae_keychain_last_status()
    if st == 0 { return v, "" }
    if st == NOT_FOUND { return "", "not found" }
    return "", "keychain: ${status_text(st)} (${st})"
}

// "" or an error; deleting what is not there is "not found".
delete(service: string, account: string) -> string {
    st = macae_keychain_delete(service, account)
    if st == 0 { return "" }
    if st == NOT_FOUND { return "not found" }
    return "keychain: ${status_text(st)} (${st})"
}
